<ui:FluentWindow x:Class="ScriptHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:ScriptHub.Views"
        xmlns:conv="clr-namespace:ScriptHub.Converters"
        Title="Script Hub — Центр управления скриптами"
        Icon="Resources/app.ico"
        Height="780"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        KeyDown="FluentWindow_KeyDown">

    <ui:FluentWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:StringEqualsConverter x:Key="StringEqualsConv" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Window TitleBar / Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Execution Console Drawer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER & TITLEBAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                MouseDown="TitleBar_MouseDown">
            <Grid Height="50">
                <Grid.ColumnDefinitions>
                    <!-- Left: Title & Subtitle -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Middle: Search Box -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Quick Actions & Window Controls -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: App Icon, Title & Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,24,0">
                    <Border Width="32" Height="32"
                            CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            Margin="0,0,10,0">
                        <Image Source="Resources/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality" Margin="2" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Script Hub"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Border CornerRadius="4"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Padding="5,1"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding AppVersion}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Центр управления PowerShell и CMD скриптами"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Middle: Global Instant Search Bar -->
                <Grid Grid.Column="1" MaxWidth="480" Margin="16,0">
                    <ui:TextBox x:Name="SearchBox"
                                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Поиск скриптов по названию, коду или тегам..."
                                VerticalAlignment="Center"
                                Height="34">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>
                </Grid>

                <!-- Right: Quick Actions & System TitleBar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <!-- GitHub Update Button (with Notification Dot Badge) -->
                    <Grid Margin="0,0,4,0">
                        <ui:Button Appearance="Transparent"
                                   Width="34" Height="34"
                                   Padding="0"
                                   Command="{Binding UpdateFromGitHubCommand}"
                                   ToolTip="Проверить и установить обновления">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" />
                        </ui:Button>

                        <!-- Notification indicator dot when update is available -->
                        <Border Width="8" Height="8"
                                CornerRadius="4"
                                Background="#FF3B30"
                                BorderBrush="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderThickness="1.5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,4,4,0"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisConv}}" />
                    </Grid>

                    <!-- Terminal Button (Header Quick Access) -->
                    <ui:Button Appearance="Transparent"
                               Width="34" Height="34"
                               Padding="0"
                               Margin="0,0,4,0"
                               Command="{Binding ToggleTerminalCommand}"
                               ToolTip="Интерактивный терминал (Ctrl+` или F12)">
                        <ui:SymbolIcon Symbol="WindowConsole20" FontSize="16" />
                    </ui:Button>

                    <!-- Theme Toggle -->
                    <ui:Button Appearance="Transparent"
                               Width="34" Height="34"
                               Padding="0"
                               Margin="0,0,4,0"
                               Command="{Binding ToggleThemeCommand}"
                               ToolTip="Переключить тему оформления">
                        <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="16" />
                    </ui:Button>

                    <!-- Settings Button -->
                    <ui:Button Appearance="Transparent"
                               Width="34" Height="34"
                               Padding="0"
                               Margin="0,0,12,0"
                               Command="{Binding NavigateCommand}"
                               CommandParameter="Settings"
                               ToolTip="Настройки (Ctrl+,)">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                    </ui:Button>

                    <!-- Standard Windows TitleBar minimize, maximize, close buttons -->
                    <ui:TitleBar Width="140" Height="48" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN BODY (SIDEBAR + CONTENT) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Navigation Bar -->
                <ColumnDefinition Width="220" />
                <!-- Content View -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION PANEL -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="12,16,12,16">
                    <Grid.RowDefinitions>
                        <!-- Navigation Items -->
                        <RowDefinition Height="*" />
                        <!-- Bottom: Action Buttons -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="МЕНЮ"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="10,0,0,10" />

                        <!-- 1. All Scripts -->
                        <RadioButton GroupName="NavGroup"
                                     IsChecked="{Binding CurrentNavTag, Converter={StaticResource StringEqualsConv}, ConverterParameter='All'}"
                                     Margin="0,0,0,4"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="All"
                                     Style="{StaticResource NavRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="Все скрипты" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 2. PowerShell -->
                        <RadioButton GroupName="NavGroup"
                                     IsChecked="{Binding CurrentNavTag, Converter={StaticResource StringEqualsConv}, ConverterParameter='PowerShell'}"
                                     Margin="0,0,0,4"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="PowerShell"
                                     Style="{StaticResource NavRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="16" Foreground="#0078D4" Margin="0,0,10,0" />
                                <TextBlock Text="PowerShell" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 3. CMD / BAT -->
                        <RadioButton GroupName="NavGroup"
                                     IsChecked="{Binding CurrentNavTag, Converter={StaticResource StringEqualsConv}, ConverterParameter='Batch'}"
                                     Margin="0,0,0,4"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Batch"
                                     Style="{StaticResource NavRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="WindowConsole20" FontSize="16" Foreground="#D83B01" Margin="0,0,10,0" />
                                <TextBlock Text="CMD / BAT" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 4. Favorites -->
                        <RadioButton GroupName="NavGroup"
                                     IsChecked="{Binding CurrentNavTag, Converter={StaticResource StringEqualsConv}, ConverterParameter='Favorites'}"
                                     Margin="0,0,0,4"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Favorites"
                                     Style="{StaticResource NavRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Star24" FontSize="16" Foreground="#FFB900" Margin="0,0,10,0" />
                                <TextBlock Text="Избранное" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 5. Run History -->
                        <RadioButton GroupName="NavGroup"
                                     IsChecked="{Binding CurrentNavTag, Converter={StaticResource StringEqualsConv}, ConverterParameter='History'}"
                                     Margin="0,0,0,4"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="History"
                                     Style="{StaticResource NavRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="History24" FontSize="16" Foreground="#881798" Margin="0,0,10,0" />
                                <TextBlock Text="История запусков" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <Separator Margin="6,8,6,8" />

                        <!-- 6. Settings -->
                        <RadioButton GroupName="NavGroup"
                                     IsChecked="{Binding CurrentNavTag, Converter={StaticResource StringEqualsConv}, ConverterParameter='Settings'}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Settings"
                                     Style="{StaticResource NavRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="Настройки" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom: Action Buttons (+ Add Script & Terminal) -->
                    <StackPanel Grid.Row="1">
                        <!-- 1. Add Script Button -->
                        <ui:Button Appearance="Primary"
                                   HorizontalAlignment="Stretch"
                                   Height="36"
                                   Padding="12,0"
                                   Margin="0,0,0,6"
                                   Command="{Binding ShowAddScriptCommand}"
                                   ToolTip="Создать или импортировать новый скрипт (Ctrl+N)">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="Добавить скрипт" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                        </ui:Button>

                        <!-- 2. Interactive Terminal Button -->
                        <ui:Button Appearance="Secondary"
                                   HorizontalAlignment="Stretch"
                                   Height="34"
                                   Padding="10,0"
                                   Command="{Binding ToggleTerminalCommand}"
                                   ToolTip="Открыть встроенный интерактивный терминал (Ctrl+` или F12)">
                            <Grid HorizontalAlignment="Stretch" Width="176">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="WindowConsole20" FontSize="15" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Терминал" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="5,1">
                                    <TextBlock Text="Ctrl+`" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT MAIN CONTENT -->
            <Grid Grid.Column="1">
                <!-- 1. Tiles Grid View -->
                <Grid Visibility="{Binding IsTilesViewActive, Converter={StaticResource BoolToVisConv}}">
                    <views:MainView />
                </Grid>

                <!-- 2. Script Editor View -->
                <Grid Visibility="{Binding IsEditorViewActive, Converter={StaticResource BoolToVisConv}}">
                    <views:ScriptEditorView DataContext="{Binding EditorVM}" />
                </Grid>

                <!-- 3. Add Script Wizard View -->
                <Grid Visibility="{Binding IsAddScriptViewActive, Converter={StaticResource BoolToVisConv}}">
                    <views:AddScriptDialog DataContext="{Binding AddScriptVM}" />
                </Grid>

                <!-- 4. History View -->
                <Grid Visibility="{Binding IsHistoryViewActive, Converter={StaticResource BoolToVisConv}}">
                    <views:HistoryView DataContext="{Binding HistoryVM}" />
                </Grid>

                <!-- 5. Settings View -->
                <Grid Visibility="{Binding IsSettingsViewActive, Converter={StaticResource BoolToVisConv}}">
                    <views:SettingsView DataContext="{Binding SettingsVM}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- 3. BOTTOM EXECUTION CONSOLE DRAWER -->
        <Grid Grid.Row="2" Visibility="{Binding ConsoleVM.IsOpen, Converter={StaticResource BoolToVisConv}}">
            <views:ExecutionConsoleView DataContext="{Binding ConsoleVM}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
