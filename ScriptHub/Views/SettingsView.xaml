<UserControl x:Class="ScriptHub.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:ScriptHub.Models"
             xmlns:conv="clr-namespace:ScriptHub.Converters">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrushConv" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConv" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <!-- Top Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Settings Cards Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Настройки" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Параметры интерфейса, темы оформления, категорий и резервного копирования"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- SETTINGS SCROLL CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel MaxWidth="840" HorizontalAlignment="Left">

                <!-- 1. APPEARANCE -->
                <TextBlock Text="Внешний вид" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Theme Selection -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Тема оформления" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Выберите светлую, темную тему или тему как в Windows 11"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      Width="160">
                                <ComboBoxItem Content="Как в системе" Tag="{x:Static models:ThemeMode.System}" />
                                <ComboBoxItem Content="Светлая" Tag="{x:Static models:ThemeMode.Light}" />
                                <ComboBoxItem Content="Темная" Tag="{x:Static models:ThemeMode.Dark}" />
                            </ComboBox>
                        </Grid>

                        <Separator Margin="0,4,0,14" />

                        <!-- Default Tile Size -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Размер плиток по умолчанию" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Масштаб отображения карточек скриптов на главном экране"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding DefaultTileSize, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      Width="160">
                                <ComboBoxItem Content="Стандартный" Tag="{x:Static models:TileSize.Standard}" />
                                <ComboBoxItem Content="Широкий" Tag="{x:Static models:TileSize.Wide}" />
                                <ComboBoxItem Content="Компактный" Tag="{x:Static models:TileSize.Compact}" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. EXECUTION & DIRECTORIES -->
                <TextBlock Text="Запуск и поведение" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Prefer PowerShell 7 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Использовать PowerShell 7 (pwsh.exe)" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Автоматически использовать современный PowerShell 7+, если он установлен"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding PreferPowerShell7}" />
                        </Grid>

                        <Separator Margin="0,4,0,14" />

                        <!-- Confirm Deletion -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Подтверждать удаление скриптов" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Показывать диалоговое окно подтверждения перед удалением плитки"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding ConfirmBeforeDeletion}" />
                        </Grid>

                        <Separator Margin="0,4,0,14" />

                        <!-- Default Working Directory -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Рабочая папка по умолчанию" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Используется, если у скрипта не задана персональная рабочая папка"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            Text="{Binding DefaultWorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="По умолчанию"
                                            Margin="0,0,4,0" />
                                <ui:Button Grid.Column="1"
                                           Content="..."
                                           Command="{Binding BrowseDefaultWorkDirCommand}"
                                           ToolTip="Выбрать папку" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. CATEGORIES MANAGEMENT -->
                <TextBlock Text="Управление категориями" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Add new category form -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Название новой категории..."
                                        Margin="0,0,8,0" />

                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding NewCategoryColor}"
                                      SelectedValuePath="Tag"
                                      Margin="0,0,8,0">
                                <ComboBoxItem Tag="#0078D4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="#0078D4" Margin="0,0,6,0" />
                                        <TextBlock Text="Синий" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="#107C41">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="#107C41" Margin="0,0,6,0" />
                                        <TextBlock Text="Зеленый" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="#D83B01">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="#D83B01" Margin="0,0,6,0" />
                                        <TextBlock Text="Оранжевый" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="#881798">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="#881798" Margin="0,0,6,0" />
                                        <TextBlock Text="Фиолетовый" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="#E81123">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="#E81123" Margin="0,0,6,0" />
                                        <TextBlock Text="Красный" />
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>

                            <ui:Button Grid.Column="2"
                                       Content="+ Добавить"
                                       Appearance="Primary"
                                       Command="{Binding AddCategoryCommand}" />
                        </Grid>

                        <!-- Existing Categories List -->
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="10,6"
                                            Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10"
                                                     Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConv}}"
                                                     Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,8,0" />

                                            <ui:Button Appearance="Transparent"
                                                       Padding="2"
                                                       Visibility="{Binding IsSystem, Converter={StaticResource BoolToVisConv}, ConverterParameter=Inverted}"
                                                       Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Удалить категорию">
                                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                                            </ui:Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 4. BACKUP & RESTORE -->
                <TextBlock Text="Резервное копирование и перенос" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Экспорт и импорт полной конфигурации" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Позволяет создать полный ZIP-архив со всеми скриптами, настройками и категориями для переноса Script Hub на другой ПК."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,16" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:Button Appearance="Primary"
                                       Margin="0,0,10,0"
                                       Command="{Binding ExportBackupCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,6,0" />
                                    <TextBlock Text="Экспорт конфигурации (.zip)" />
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Appearance="Secondary"
                                       Command="{Binding ImportBackupCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="16" Margin="0,0,6,0" />
                                    <TextBlock Text="Импорт конфигурации (.zip)" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>

                        <!-- Status text -->
                        <TextBlock Text="{Binding BackupStatusMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   Visibility="{Binding BackupStatusMessage, Converter={StaticResource NullOrEmptyToVisConv}}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 5. ABOUT APP -->
                <TextBlock Text="О приложении" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="48" Height="48"
                                CornerRadius="8"
                                Background="#1A0078D4"
                                Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="26" Foreground="#0078D4" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Script Hub — Windows 11 Script Launcher" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="Версия 1.0.0 · .NET 8 · WPF + Wpf.Ui · AvalonEdit"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="Центр управления и быстрого запуска PowerShell и CMD-скриптов с поддержкой Windows 11 Fluent Design."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="0,4,0,0" />
                            <Border CornerRadius="4"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Padding="8,4"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0">
                                <TextBlock Text="Автор: Ларионов Никита (02.09.26)"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
