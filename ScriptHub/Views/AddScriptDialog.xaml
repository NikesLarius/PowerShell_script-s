<UserControl x:Class="ScriptHub.Views.AddScriptDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Options Cards Grid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Transparent"
                           Width="34" Height="34"
                           Padding="0"
                           Margin="0,0,12,0"
                           Command="{Binding CancelCommand}"
                           ToolTip="Вернуться назад">
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18" />
                </ui:Button>

                <StackPanel>
                    <TextBlock Text="Добавление скрипта"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Выберите способ добавления скрипта в коллекцию Script Hub"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- OPTIONS CARDS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center" Margin="0,24,0,0">
                <TextBlock Text="Как вы хотите добавить скрипт?"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24" />

                <!-- 1. IMPORT EXISTING -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="52" Height="52"
                                CornerRadius="8"
                                Background="#1A0078D4"
                                Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="26" Foreground="#0078D4" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Импортировать существующий скрипт"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Выбрать файл .ps1, .bat или .cmd на вашем компьютере. Приложение автоматически определит параметры."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <ui:Button Grid.Column="2"
                                   Content="Выбрать файл..."
                                   Appearance="Primary"
                                   Height="36"
                                   Padding="16,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Command="{Binding ImportExistingCommand}"
                                   Margin="16,0,0,0" />
                    </Grid>
                </Border>

                <!-- 2. CREATE POWERSHELL -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="52" Height="52"
                                CornerRadius="8"
                                Background="#1A0078D4"
                                Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="26" Foreground="#0078D4" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Создать новый PowerShell скрипт (.ps1)"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Открыть встроенный редактор с подсветкой синтаксиса для написания нового PowerShell скрипта."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <ui:Button Grid.Column="2"
                                   Content="Создать .ps1"
                                   Appearance="Secondary"
                                   Height="36"
                                   Padding="16,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Command="{Binding CreateNewPowerShellCommand}"
                                   Margin="16,0,0,0" />
                    </Grid>
                </Border>

                <!-- 3. CREATE BATCH/CMD -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="52" Height="52"
                                CornerRadius="8"
                                Background="#1AD83B01"
                                Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="WindowConsole20" FontSize="26" Foreground="#D83B01" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Создать новый CMD / Batch скрипт (.bat)"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Открыть встроенный редактор для написания командного файла Windows Batch."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <ui:Button Grid.Column="2"
                                   Content="Создать .bat"
                                   Appearance="Secondary"
                                   Height="36"
                                   Padding="16,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Command="{Binding CreateNewBatchCommand}"
                                   Margin="16,0,0,0" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
