<UserControl x:Class="ScriptHub.Views.ExecutionConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:ScriptHub.Converters">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColorConv" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConv" />
    </UserControl.Resources>

    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            MinHeight="200"
            MaxHeight="450">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Toolbar Header -->
                <RowDefinition Height="Auto" />
                <!-- Terminal Output -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- HEADER / TOOLBAR -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title, Status, Duration -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="WindowConsole20" FontSize="16" Margin="0,0,8,0" />
                        
                        <TextBlock Text="Вывод выполнения:"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,6,0" />

                        <TextBlock Text="{Binding ScriptTitle}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   Margin="0,0,12,0" />

                        <!-- Status badge -->
                        <Border CornerRadius="4"
                                Padding="8,2"
                                Background="{Binding Status, Converter={StaticResource StatusToColorConv}}"
                                Margin="0,0,10,0">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>

                        <!-- Duration -->
                        <TextBlock Text="{Binding DurationFormatted}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                    </StackPanel>

                    <!-- Right: Control Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Stop Button -->
                        <ui:Button Appearance="Danger"
                                   Padding="10,4"
                                   Margin="0,0,6,0"
                                   Command="{Binding StopCommand}"
                                   IsEnabled="{Binding IsRunning}"
                                   ToolTip="Остановить выполнение">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Stop20" FontSize="13" Margin="0,0,4,0" />
                                <TextBlock Text="Остановить" FontSize="12" />
                            </StackPanel>
                        </ui:Button>

                        <!-- Copy Log -->
                        <ui:Button Appearance="Secondary"
                                   Padding="8,4"
                                   Margin="0,0,6,0"
                                   Command="{Binding CopyCommand}"
                                   ToolTip="Скопировать весь вывод в буфер обмена">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Copy20" FontSize="13" Margin="0,0,4,0" />
                                <TextBlock Text="Копировать" FontSize="12" />
                            </StackPanel>
                        </ui:Button>

                        <!-- Clear Log -->
                        <ui:Button Appearance="Secondary"
                                   Padding="8,4"
                                   Margin="0,0,6,0"
                                   Command="{Binding ClearCommand}"
                                   ToolTip="Очистить вывод">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DismissCircle20" FontSize="13" Margin="0,0,4,0" />
                                <TextBlock Text="Очистить" FontSize="12" />
                            </StackPanel>
                        </ui:Button>

                        <!-- Close Drawer -->
                        <ui:Button Appearance="Transparent"
                                   Padding="6,4"
                                   Command="{Binding CloseCommand}"
                                   ToolTip="Скрыть консоль">
                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TERMINAL TEXT BOX -->
            <TextBox Grid.Row="1"
                     x:Name="TerminalTextBox"
                     Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Cascadia Code, Segoe UI Mono, Courier New"
                     FontSize="12.5"
                     Background="#0C0C0C"
                     Foreground="#CCCCCC"
                     CaretBrush="#FFFFFF"
                     BorderThickness="0"
                     Padding="14"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap" />
        </Grid>
    </Border>
</UserControl>
