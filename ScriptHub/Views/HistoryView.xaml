<UserControl x:Class="ScriptHub.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:ScriptHub.Converters">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColorConv" />
        <conv:ScriptTypeToColorConverter x:Key="ScriptTypeToColorConv" />
        <conv:ScriptTypeToIconConverter x:Key="ScriptTypeToIconConv" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConv" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Header Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- History List -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="История запусков" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Журнал выполненных PowerShell и CMD-скриптов с метриками и статусами"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Поиск в истории..."
                                Width="220"
                                Height="34"
                                Margin="0,0,8,0">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" FontSize="14" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <ui:Button Appearance="Secondary"
                               Width="34" Height="34"
                               Padding="0"
                               Margin="0,0,8,0"
                               Command="{Binding RefreshCommand}"
                               ToolTip="Обновить список">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                    </ui:Button>

                    <ui:Button Appearance="Danger"
                               Height="34"
                               Padding="14,0"
                               Command="{Binding ClearHistoryCommand}"
                               ToolTip="Очистить всю историю">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Очистить историю" FontWeight="SemiBold" FontSize="12.5" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1" Margin="24">
            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding FilteredItems.Count, Converter={StaticResource BoolToVisConv}, ConverterParameter=Inverted}">
                <ui:SymbolIcon Symbol="History24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12" />
                <TextBlock Text="История запусков пуста"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Запущенные скрипты будут автоматически появляться в этом списке"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- List View -->
            <ListView ItemsSource="{Binding FilteredItems}"
                      SelectedItem="{Binding SelectedEntry}"
                      BorderThickness="0"
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Status Indicator Dot -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Script Details -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Timing & Exit Code -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Actions -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Status Icon -->
                                <Border Grid.Column="0"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        Background="{Binding Status, Converter={StaticResource StatusToColorConv}}"
                                        Opacity="0.15"
                                        Margin="0,0,12,0" />
                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="Play24"
                                               FontSize="16"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToColorConv}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />

                                <!-- Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding ScriptTitle}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,8,0" />

                                        <Border CornerRadius="4"
                                                Padding="6,1"
                                                Background="{Binding ScriptType, Converter={StaticResource ScriptTypeToColorConv}}">
                                            <TextBlock Text="{Binding ScriptType}"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ScriptFilePath}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Timing / Metrics -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0">
                                    <TextBlock Text="{Binding StartTime, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Duration.TotalSeconds, StringFormat='{}{0:F2} сек.'}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,0,8,0" />

                                        <Border CornerRadius="3"
                                                Padding="4,0"
                                                Background="{Binding Status, Converter={StaticResource StatusToColorConv}}">
                                            <TextBlock Text="{Binding ExitCode, StringFormat='Код: {0}'}"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Appearance="Primary"
                                               Width="32" Height="32"
                                               Padding="0"
                                               Margin="0,0,6,0"
                                               Command="{Binding DataContext.RerunCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               ToolTip="Запустить повторно">
                                        <ui:SymbolIcon Symbol="Play20" FontSize="14" />
                                    </ui:Button>

                                    <ui:Button Appearance="Secondary"
                                               Width="32" Height="32"
                                               Padding="0"
                                               Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               ToolTip="Удалить из истории">
                                        <ui:SymbolIcon Symbol="Delete20" FontSize="14" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
