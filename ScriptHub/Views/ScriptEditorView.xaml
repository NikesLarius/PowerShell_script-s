<UserControl x:Class="ScriptHub.Views.ScriptEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:conv="clr-namespace:ScriptHub.Converters"
             xmlns:models="clr-namespace:ScriptHub.Models">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConv" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Top Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content (Sidebar + Editor) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Back -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Transparent"
                               Width="34" Height="34"
                               Padding="0"
                               Margin="0,0,12,0"
                               Command="{Binding CancelCommand}"
                               ToolTip="Вернуться назад">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18" />
                    </ui:Button>

                    <StackPanel>
                        <TextBlock Text="{Binding Title, FallbackValue='Редактор скрипта'}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Встроенный редактор PowerShell и CMD скриптов"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Отмена"
                               Appearance="Secondary"
                               Height="34"
                               Padding="14,0"
                               Margin="0,0,8,0"
                               Command="{Binding CancelCommand}" />

                    <ui:Button Appearance="Secondary"
                               Height="34"
                               Padding="14,0"
                               Margin="0,0,8,0"
                               Command="{Binding SaveCommand}"
                               ToolTip="Сохранить изменения (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Сохранить" FontSize="12.5" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Primary"
                               Height="34"
                               Padding="14,0"
                               Command="{Binding SaveAndRunCommand}"
                               ToolTip="Сохранить и сразу запустить (F5)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Сохранить и запустить" FontWeight="SemiBold" FontSize="12.5" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="24,16,24,24">
            <Grid.ColumnDefinitions>
                <!-- Parameters Sidebar -->
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <!-- Code Editor Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PARAMETERS CARD -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Параметры скрипта"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16" />

                        <!-- Validation Error Message -->
                        <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                CornerRadius="4"
                                Padding="8,6"
                                Margin="0,0,0,12"
                                Visibility="{Binding ValidationError, Converter={StaticResource NullOrEmptyToVisConv}}">
                            <TextBlock Text="{Binding ValidationError}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Title Field -->
                        <TextBlock Text="Название скрипта *"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Например: Сортировка файлов"
                                    Margin="0,0,0,12" />

                        <!-- Description Field -->
                        <TextBlock Text="Описание"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Краткое описание назначения скрипта..."
                                    AcceptsReturn="True"
                                    Height="60"
                                    Margin="0,0,0,12" />

                        <!-- Script Type -->
                        <TextBlock Text="Тип скрипта"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <ComboBox SelectedValue="{Binding ScriptType}"
                                  SelectedValuePath="DataContext"
                                  Margin="0,0,0,12">
                            <ComboBoxItem Content="PowerShell (.ps1)" DataContext="{x:Static models:ScriptType.PowerShell}" />
                            <ComboBoxItem Content="Batch (.bat)" DataContext="{x:Static models:ScriptType.Batch}" />
                            <ComboBoxItem Content="CMD (.cmd)" DataContext="{x:Static models:ScriptType.Cmd}" />
                        </ComboBox>

                        <!-- Category -->
                        <TextBlock Text="Категория"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedValue="{Binding SelectedCategoryId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,12" />

                        <!-- Run As Admin -->
                        <CheckBox IsChecked="{Binding RunAsAdmin}"
                                  Content="Запуск от имени администратора (UAC)"
                                  Margin="0,0,0,12" />

                        <!-- Working Directory Mode -->
                        <TextBlock Text="Рабочая папка"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <ComboBox SelectedValue="{Binding WorkingDirectoryMode}"
                                  SelectedValuePath="DataContext"
                                  Margin="0,0,0,6">
                            <ComboBoxItem Content="Папка со скриптом" DataContext="{x:Static models:WorkingDirectoryMode.ScriptDirectory}" />
                            <ComboBoxItem Content="Пользовательская папка" DataContext="{x:Static models:WorkingDirectoryMode.CustomDirectory}" />
                            <ComboBoxItem Content="Папка приложения" DataContext="{x:Static models:WorkingDirectoryMode.AppDirectory}" />
                            <ComboBoxItem Content="Системная по умолчанию" DataContext="{x:Static models:WorkingDirectoryMode.SystemDefault}" />
                        </ComboBox>

                        <!-- Custom Directory Input -->
                        <Grid Visibility="{Binding IsCustomWorkDirVisible, Converter={StaticResource BoolToVisConv}}" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding CustomWorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="C:\Users\..."
                                        Margin="0,0,4,0" />
                            <ui:Button Grid.Column="1"
                                       Content="..."
                                       Command="{Binding BrowseCustomWorkDirCommand}"
                                       ToolTip="Выбрать папку" />
                        </Grid>

                        <!-- Arguments -->
                        <TextBlock Text="Аргументы запуска"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Например: -Path 'C:\Downloads' -Force"
                                    Margin="0,0,0,12" />

                        <!-- File Path -->
                        <TextBlock Text="Путь к файлу на диске"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding FilePath, Mode=OneWay}"
                                        IsReadOnly="True"
                                        PlaceholderText="Будет создан автоматически в хранилище"
                                        Margin="0,0,4,0" />
                            <ui:Button Grid.Column="1"
                                       Content="Обзор"
                                       Command="{Binding BrowseScriptFileCommand}"
                                       ToolTip="Выбрать существующий файл" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT CODE EDITOR -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Editor Header Info -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,8"
                            CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Code24" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="Код скрипта" FontWeight="SemiBold" FontSize="13" Margin="0,0,12,0" />
                                <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <TextBlock Text="{Binding SyntaxName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="Горячие клавиши: Ctrl+S (сохранить), Ctrl+F (поиск)"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- AvalonEdit Editor -->
                    <avalon:TextEditor Grid.Row="1"
                                       x:Name="CodeEditor"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="13.5"
                                       ShowLineNumbers="True"
                                       LineNumbersForeground="#6E7681"
                                       Background="#1E1E1E"
                                       Foreground="#D4D4D4"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"
                                       Padding="8,8" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
