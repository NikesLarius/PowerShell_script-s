<UserControl x:Class="ScriptHub.Controls.ScriptTileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:ScriptHub.Converters"
             xmlns:models="clr-namespace:ScriptHub.Models">

    <UserControl.Resources>
        <conv:ScriptTypeToColorConverter x:Key="ScriptTypeToColorConv" />
        <conv:ScriptTypeToIconConverter x:Key="ScriptTypeToIconConv" />
        <conv:StatusToColorConverter x:Key="StatusToColorConv" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:HexToBrushConverter x:Key="HexToBrushConv" />

        <Style x:Key="TileBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource TileBorderStyle}" MouseLeftButtonUp="Card_MouseLeftButtonUp">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 1. Header: Type, Admin, Missing warning, Favorite -->
                <RowDefinition Height="Auto" />
                <!-- 2. Content: Title, Category, Description -->
                <RowDefinition Height="*" />
                <!-- 3. Working Directory Bar / Quick Input -->
                <RowDefinition Height="Auto" />
                <!-- 4. Footer: Status info, Run button, Context Menu -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. TOP ROW -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <!-- Type Badge -->
                    <Border CornerRadius="4"
                            Padding="6,2"
                            Background="{Binding ScriptType, Converter={StaticResource ScriptTypeToColorConv}}"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding ScriptType, Converter={StaticResource ScriptTypeToIconConv}}"
                                           FontSize="12"
                                           Foreground="White"
                                           Margin="0,0,4,0" />
                            <TextBlock Text="{Binding ScriptType}"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- Run as Admin Shield -->
                    <Border CornerRadius="4"
                            Padding="4,2"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            Visibility="{Binding RunAsAdmin, Converter={StaticResource BoolToVisConv}}"
                            ToolTip="Запуск от имени администратора"
                            Margin="0,0,6,0">
                        <ui:SymbolIcon Symbol="Shield20" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    </Border>

                    <!-- Missing file badge -->
                    <Border CornerRadius="4"
                            Padding="6,2"
                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                            Visibility="{Binding IsFileMissing, Converter={StaticResource BoolToVisConv}}"
                            ToolTip="Файл скрипта не найден на диске!">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning20" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,4,0" />
                            <TextBlock Text="Файл не найден" FontSize="11" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Favorite Star Button -->
                <ui:Button Grid.Column="1"
                           Appearance="Transparent"
                           Padding="4"
                           Command="{Binding ToggleFavoriteCommand}"
                           ToolTip="Добавить в избранное">
                    <ui:SymbolIcon Symbol="Star24"
                                   Filled="{Binding IsFavorite}"
                                   FontSize="16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Foreground" Value="#FFD700" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button>
            </Grid>

            <!-- 2. MIDDLE CONTENT ROW -->
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <!-- Title -->
                <TextBlock Text="{Binding Title}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,4"
                           ToolTip="{Binding Title}" />

                <!-- Category Pill -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border CornerRadius="3"
                            Padding="5,1"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding CategoryName}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Description (Full when expanded, compact when collapsed) -->
                <TextBlock Text="{Binding Description}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           ToolTip="{Binding Description}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="MaxHeight" Value="36" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="MaxHeight" Value="200" />
                                    <Setter Property="TextTrimming" Value="None" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- 3. WORKING DIRECTORY PANEL -->
            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <!-- Minimal Working Directory Summary (visible when NOT expanded) -->
                <Border CornerRadius="4"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="6,4"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisConv}, ConverterParameter=Inverted}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="13" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding DisplayWorkingDirectory}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Full Expanded Working Directory Editor Panel (visible when expanded) -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisConv}}">
                    <StackPanel>
                        <TextBlock Text="Рабочая папка для запуска:"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,6" />

                        <!-- Editable Folder Path with Paste & Browse -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding CustomWorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Вставьте путь к папке (C:\...)"
                                        FontSize="11"
                                        Height="30"
                                        Margin="0,0,6,0" />

                            <ui:Button Grid.Column="1"
                                       Content="Обзор..."
                                       Padding="10,4"
                                       Height="30"
                                       FontSize="11"
                                       Command="{Binding BrowseFolderCommand}"
                                       ToolTip="Выбрать папку на диске" />
                        </Grid>

                        <!-- Presets Chips: Downloads, Desktop, ScriptDir (WrapPanel prevents cutting off) -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Appearance="Secondary"
                                       Padding="8,4"
                                       FontSize="11"
                                       Margin="0,0,6,4"
                                       Command="{Binding SetPresetDownloadsCommand}"
                                       ToolTip="Запустить в папке 'Загрузки'">
                                <TextBlock Text="⬇ Загрузки" />
                            </ui:Button>

                            <ui:Button Appearance="Secondary"
                                       Padding="8,4"
                                       FontSize="11"
                                       Margin="0,0,6,4"
                                       Command="{Binding SetPresetDesktopCommand}"
                                       ToolTip="Запустить на Рабочем столе">
                                <TextBlock Text="🖥 Раб. стол" />
                            </ui:Button>

                            <ui:Button Appearance="Secondary"
                                       Padding="8,4"
                                       FontSize="11"
                                       Margin="0,0,6,4"
                                       Command="{Binding SetPresetScriptDirCommand}"
                                       ToolTip="Запустить в папке со скриптом">
                                <TextBlock Text="📁 Скрипт" />
                            </ui:Button>
                        </WrapPanel>

                        <!-- Pin Checkbox -->
                        <CheckBox IsChecked="{Binding IsPinnedCustomDirectory}"
                                  Content="Закрепить эту папку для скрипта"
                                  FontSize="11"
                                  ToolTip="Сохранить эту папку как постоянную для всех последующих запусков скрипта" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 4. FOOTER ROW -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status & Timing -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{Binding LastStatus, Converter={StaticResource StatusToColorConv}}"
                                 Margin="0,0,5,0" />
                        <TextBlock Text="{Binding LastStatusFormatted}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastRunAtFormatted}"
                               FontSize="10"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="12,1,0,0" />
                </StackPanel>

                <!-- Run Button -->
                <ui:Button Grid.Column="1"
                           Appearance="Primary"
                           Padding="10,6"
                           Margin="0,0,4,0"
                           Command="{Binding RunCommand}"
                           ToolTip="Запустить скрипт в выбранной папке">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play20" FontSize="13" Margin="0,0,4,0" />
                        <TextBlock Text="Запустить" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </ui:Button>

                <!-- More Menu Button (⋯) with Left Click Support -->
                <ui:Button Grid.Column="2"
                           x:Name="MoreOptionsButton"
                           Appearance="Secondary"
                           Padding="6"
                           Click="MoreButton_Click"
                           ToolTip="Дополнительные действия">
                    <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16" />
                    <ui:Button.ContextMenu>
                        <ContextMenu x:Name="TileContextMenu">
                            <MenuItem Header="Запустить" Command="{Binding RunCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Play20" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Редактировать" Command="{Binding EditCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Edit20" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Раскрыть / Свернуть" Command="{Binding ToggleExpandedCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Maximize20" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Открыть папку со скриптом" Command="{Binding OpenFolderCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="FolderOpen20" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Открыть файл в системе" Command="{Binding OpenFileCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Document20" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Скопировать путь к файлу" Command="{Binding CopyPathCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Copy20" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="В избранное" Command="{Binding ToggleFavoriteCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Star20" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Delete20" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
